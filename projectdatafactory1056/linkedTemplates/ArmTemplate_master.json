{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "projectdatafactory1056"
		},
		"LS_AZURESQL_SOURCE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZURESQL_SOURCE'"
		},
		"LS_AzureSQL_Audit_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Audit'"
		},
		"LS_ADLS_Gen2_Sink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://destination1056.dfs.core.windows.net/"
		},
		"LS_AZURESQL_SOURCE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "projectdatabaseserver123.database.windows.net"
		},
		"LS_AZURESQL_SOURCE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "projectdatabase"
		},
		"LS_AZURESQL_SOURCE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminLena"
		},
		"LS_AzureSQL_Audit_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "projectdatabaseserver123.database.windows.net"
		},
		"LS_AzureSQL_Audit_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "projectdatabase"
		},
		"LS_AzureSQL_Audit_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminLena"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "projectdatafactory1056_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AZURESQL_SOURCE_password": {
						"value": "[parameters('LS_AZURESQL_SOURCE_password')]"
					},
					"LS_AzureSQL_Audit_password": {
						"value": "[parameters('LS_AzureSQL_Audit_password')]"
					},
					"LS_ADLS_Gen2_Sink_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Gen2_Sink_properties_typeProperties_url')]"
					},
					"LS_AZURESQL_SOURCE_properties_typeProperties_server": {
						"value": "[parameters('LS_AZURESQL_SOURCE_properties_typeProperties_server')]"
					},
					"LS_AZURESQL_SOURCE_properties_typeProperties_database": {
						"value": "[parameters('LS_AZURESQL_SOURCE_properties_typeProperties_database')]"
					},
					"LS_AZURESQL_SOURCE_properties_typeProperties_userName": {
						"value": "[parameters('LS_AZURESQL_SOURCE_properties_typeProperties_userName')]"
					},
					"LS_AzureSQL_Audit_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Audit_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Audit_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Audit_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Audit_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Audit_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}